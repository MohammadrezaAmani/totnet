# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000
ENCRYPTION_KEY=replace-with-32-or-more-random-bytes

# Telegram and optional VPN provider credentials
TELEGRAM_BOT_TOKEN=
# Both socks:// and socks5:// are accepted. Leave blank for direct Telegram access.
SOCKS5_PROXY=socks5://127.0.0.1:2080
PASARGUARD_API_KEY=
MARZBAN_API_KEY=
HIDDIFY_API_KEY=

# PostgreSQL (keep the password URL-safe, or set a properly URL-encoded DATABASE_URL)
DB_NAME=totnet
DB_USER=totnet
DB_PASSWORD=change-this-password
DB_PUBLISHED_PORT=54329
# DATABASE_URL=postgresql://totnet:change-this-password@db:5432/totnet

# Connectix credentials (optional; configure before enabling provider sync)
CONNECTIX_BASE_URL=https://api.connectix.vip
CONNECTIX_USERNAME=
CONNECTIX_PASSWORD=
CONNECTIX_TIMEOUT_SECONDS=20
# Optional separate proxy for Connectix; blank uses a direct connection.
CONNECTIX_PROXY_URL=
PLAN_CATALOG_CACHE_TTL_SECONDS=1800
BOT_RELOAD_INTERVAL_SECONDS=5

# Optional payment integrations
PAYMENT_GATEWAY_API_KEY=
CRYPTO_PAYMENT_API_KEY=

# Optional email delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
MAX_UPLOAD_SIZE=10485760

# Local ports and resource limits
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
WEB_WORKERS=3
WEB_TIMEOUT=90
ADMINER_PORT=8081
REDIS_CACHE_MAXMEMORY=512mb
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# Academy installer file_ids (upload files to this bot, then set their Telegram file_id).
# Restart totnet-bot after editing these values. iPhone/macOS use links only.
CONNECTIX_ANDROID_PRIORITY1_FILE_ID=
CONNECTIX_ANDROID_PRIORITY2_FILE_ID=
CONNECTIX_ANDROID_PRIORITY3_FILE_ID=
CONNECTIX_WINDOWS_FILE_ID=
CONNECTIX_LINUX_FILE_ID=
HAPP_ANDROID_FILE_ID=
HAPP_WINDOWS_FILE_ID=
HAPP_LINUX_FILE_ID=
V2RAYNG_ANDROID_ARM64_FILE_ID=
V2RAYNG_ANDROID_ARM32_FILE_ID=
CONNECTIX_LINUX_DOWNLOAD_URL=
