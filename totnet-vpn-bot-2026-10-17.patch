+"""Emergency contact export: filter correctness, tenant isolation, XLSX integrity."""
+
+from datetime import timedelta
+from io import BytesIO
+from xml.etree import ElementTree as ET
+from zipfile import ZipFile
+
+from django.test import TestCase
+from django.urls import reverse
+from django.utils import timezone
+
+from apps.accounts.models import User
+from apps.brands.models import Brand
+from apps.orders.models import Order
+from apps.subscriptions.models import Subscription, SubscriptionPlan
+from apps.vpn_providers.models import VPNProvider
+
+
+class EmergencyExportTests(TestCase):
+    def setUp(self):
+        self.brand = Brand.objects.create(name="A", slug="export-a", contact_email="a@example.invalid", bot_token="export-a")
+        self.other = Brand.objects.create(name="B", slug="export-b", contact_email="b@example.invalid", bot_token="export-b")
+        self.admin = User.objects.create_superuser(username="export-admin", email="admin@example.invalid", password="testing-only")
+        self.manager = User.objects.create_user(username="brand-manager", password="testing-only", is_staff=True, brand=self.brand)
+        self.manager.admin_brands.add(self.brand)
+        self.customer = User.objects.create_user(username="customer", phone_number="09120000001", telegram_id=121, brand=self.brand)
+        self.without = User.objects.create_user(username="without", phone_number="09120000002", telegram_id=122, brand=self.brand)
+        self.expired = User.objects.create_user(username="expired", phone_number="09120000003", telegram_id=123, brand=self.brand)
+        self.other_customer = User.objects.create_user(username="other", phone_number="09990000000", telegram_id=124, brand=self.other)
+        provider = VPNProvider.objects.create(name="Provider", provider_type="connectix", base_url="https://example.invalid", brand=self.brand)
+        plan = SubscriptionPlan.objects.create(brand=self.brand, vpn_provider=provider, name="Royal", plan_type="unlimited", service_category="royal", price=100)
+        for index, (customer, exp) in enumerate(((self.customer, timezone.now() + timedelta(days=30)), (self.expired, timezone.now() - timedelta(days=2))), 1):
+            order = Order.objects.create(brand=self.brand, user=customer, plan=plan, original_price=100, final_price=100)
+            Subscription.objects.create(brand=self.brand, user=customer, owner=customer,
+                                        plan=plan, order=order, vpn_provider=provider,
+                                        status=Subscription.SubscriptionStatus.ACTIVE,
+                                        starts_at=timezone.now() - timedelta(days=2), expires_at=exp)
+
+    def _rows(self, response):
+        payload = b"".join(response.streaming_content)
+        with ZipFile(BytesIO(payload)) as archive:
+            self.assertIsNone(archive.testzip())
+            ns = {"x": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
+            root = ET.fromstring(archive.read("xl/worksheets/sheet1.xml"))
+            self.assertIsNotNone(root.find("x:autoFilter", ns))
+            rows = []
+            for row in root.findall("x:sheetData/x:row", ns):
+                rows.append([node.text or "" for node in row.findall("x:c/x:is/x:t", ns)])
+            return rows
+
+    def test_export_all_filtered_uses_exact_active_subscription_and_preserves_phone(self):
+        self.client.force_login(self.admin)
+        url = reverse("admin:accounts_user_export_filtered_xlsx")
+        response = self.client.get(url + "?has_active_subscription=yes&active_service=royal")
+        self.assertEqual(response.status_code, 200)
+        rows = self._rows(response)
+        self.assertEqual(len(rows), 2)  # header + one active customer
+        self.assertEqual(rows[1][0], "09120000001")
+        self.assertEqual(rows[1][1], "121")
+        self.assertEqual(rows[1][6], "1")
+        self.assertEqual(rows[1][7], "Royal service")
+
+    def test_negative_filter_does_not_include_expired_as_active(self):
+        self.client.force_login(self.admin)
+        url = reverse("admin:accounts_user_export_filtered_xlsx")
+        rows = self._rows(self.client.get(url + "?has_active_subscription=no"))
+        phones = [r[0] for r in rows[1:]]
+        self.assertIn("09120000002", phones)
+        self.assertIn("09120000003", phones)
+        self.assertNotIn("09120000001", phones)
+
+    def test_non_superuser_cannot_export_other_brand(self):
+        from django.contrib.auth.models import Permission
+        self.manager.user_permissions.add(Permission.objects.get(codename="view_user", content_type__app_label="accounts"))
+        self.client.force_login(self.manager)
+        url = reverse("admin:accounts_user_export_filtered_xlsx")
+        rows = self._rows(self.client.get(url))
+        self.assertFalse(any("09990000000" in row for row in rows))
+        self.assertTrue(any("09120000001" in row for row in rows))
diff -ruN -x __pycache__ -x '*.pyc' old/apps/accounts/xlsx_export.py new/apps/accounts/xlsx_export.py
--- old/apps/accounts/xlsx_export.py	1970-01-01 00:00:00.000000000 +0000
+++ new/apps/accounts/xlsx_export.py	2026-10-17 11:54:13.573941121 +0000
@@ -0,0 +1,94 @@
+"""Dependency-free, bounded-memory XLSX writer for admin emergency exports.
+
+This is deliberately a small OOXML exporter rather than introducing an
+unrelated runtime dependency. Values are always written as inline strings,
+never formulas (even when a Telegram username begins with `=`).
+"""
+
+from tempfile import SpooledTemporaryFile
+from xml.sax.saxutils import escape
+from zipfile import ZIP_DEFLATED, ZipFile
+
+from django.http import FileResponse
+
+HEADERS = (
+    "شماره تلفن", "شناسه عددی تلگرام", "نام کامل", "نام کاربری",
+    "برند", "وضعیت اشتراک", "تعداد اشتراک فعال", "سرویس‌های فعال",
+    "تاریخ انقضای نزدیک‌ترین اشتراک", "تاریخ عضویت",
+)
+
+
+def _safe_xml(value):
+    if value is None:
+        value = ""
+    # XML 1.0 forbids most C0 control characters; preserve text/phone zeroes.
+    text = str(value)
+    text = "".join(
+        ch for ch in text
+        if (ch in "\t\n\r" or ord(ch) >= 32)
+        and not 0xD800 <= ord(ch) <= 0xDFFF
+        and ord(ch) not in (0xFFFE, 0xFFFF)
+    )
+    return escape(text, {'"': '&quot;', "'": '&apos;'})
+
+
+def _column(index):
+    result = ""
+    while index:
+        index, digit = divmod(index - 1, 26)
+        result = chr(65 + digit) + result
+    return result
+
+
+def users_xlsx_response(users, *, filename="emergency_users.xlsx"):
+    """Create an Excel file with filters, frozen header and readable columns.
+
+    `users` is an iterator of ready-to-write rows; no personal data is sent to
+    external spreadsheet services. SpooledTemporaryFile limits memory use.
+    """
+    output = SpooledTemporaryFile(max_size=8 * 1024 * 1024, mode="w+b")
+    with ZipFile(output, "w", compression=ZIP_DEFLATED, compresslevel=4) as archive:
+        archive.writestr("[Content_Types].xml", '''<?xml version="1.0" encoding="UTF-8"?>
+<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/></Types>''')
+        archive.writestr("_rels/.rels", '''<?xml version="1.0" encoding="UTF-8"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>''')
+        archive.writestr("xl/workbook.xml", '''<?xml version="1.0" encoding="UTF-8"?>
+<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="Users" sheetId="1" r:id="rId1"/></sheets></workbook>''')
+        archive.writestr("xl/_rels/workbook.xml.rels", '''<?xml version="1.0" encoding="UTF-8"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>''')
+        archive.writestr("xl/styles.xml", '''<?xml version="1.0" encoding="UTF-8"?>
+<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><fonts count="2"><font><sz val="11"/><name val="Arial"/></font><font><b/><color rgb="FFFFFFFF"/><sz val="11"/><name val="Arial"/></font></fonts><fills count="3"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill><fill><patternFill patternType="solid"><fgColor rgb="FF164E63"/><bgColor indexed="64"/></patternFill></fill></fills><borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="1" fillId="2" borderId="0" xfId="0" applyFont="1" applyFill="1"/></cellXfs><cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>''')
+        with archive.open("xl/worksheets/sheet1.xml", "w") as sheet:
+            def emit(value):
+                sheet.write(value.encode("utf-8"))
+
+            emit('<?xml version="1.0" encoding="UTF-8"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetViews><sheetView workbookViewId="0" rightToLeft="1"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews><cols>')
+            for idx, width in enumerate((22, 22, 26, 25, 19, 20, 22, 40, 30, 28), 1):
+                emit(f'<col min="{idx}" max="{idx}" width="{width}" customWidth="1"/>')
+            emit('</cols><sheetData>')
+            row_number = 0
+            for row_number, row in enumerate(_with_headers(users), 1):
+                if row_number > 1048576:
+                    raise ValueError("Excel sheet row limit exceeded")
+                header_height = ' ht="27" customHeight="1"' if row_number == 1 else ""
+                emit(f'<row r="{row_number}"{header_height}>')
+                for idx, value in enumerate(row, 1):
+                    col = _column(idx)
+                    header_style = ' s="1"' if row_number == 1 else ""
+                    emit(f'<c r="{col}{row_number}" t="inlineStr"{header_style}><is><t xml:space="preserve">{_safe_xml(value)}</t></is></c>')
+                emit('</row>')
+            emit('</sheetData>')
+            emit(f'<autoFilter ref="A1:J{max(1, row_number)}"/>')
+            emit('</worksheet>')
+    output.seek(0)
+    return FileResponse(
+        output,
+        content_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        as_attachment=True,
+        filename=filename,
+    )
+
+
+def _with_headers(rows):
+    yield HEADERS
+    yield from rows
